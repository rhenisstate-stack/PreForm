# Local development only. Replace the placeholder before using a shared environment.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:4000
INTERNAL_API_URL=http://localhost:4000
API_GATEWAY_URL=http://localhost:4000

# Google OAuth 2.0 / OpenID Connect credentials
# Create OAuth 2.0 Web Client in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins: http://localhost:3000
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Support and Contact Inquiries
CONTACT_EMAIL_RECIPIENT=support@prepford.com

# BFF <-> backend gateway mutual authentication (HMAC-SHA256 over path+query, timestamp, nonce, body hash).
# MUST be 16+ characters, identical on both sides, and MUST be replaced for any shared/staging/production environment.
# Required in production (APP_ENV=production refuses to boot the signer without it).
GATEWAY_SHARED_SECRET=prepford-default-internal-gateway-secret-32-chars!

# Secret used to sign/verify the BFF-issued admin session cookie (HMAC). Must be 32+ characters in production.
SESSION_SECRET=prepford-local-dev-session-secret-change-me-32-chars!

POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=prepford
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:local-dev-only-change-me@localhost:5432/prepford?schema=public
