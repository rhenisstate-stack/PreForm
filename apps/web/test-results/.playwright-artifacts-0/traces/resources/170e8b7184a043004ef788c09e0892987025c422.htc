38:["$","section","section-9",{"id":"section-9","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"9. Legal Bases for Processing"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"Where applicable data protection legislation (such as GDPR Article 6, the Kenya Data Protection Act 2019, or UK GDPR) requires a recognized lawful basis, we process personal data under the following grounds:"}]]}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","div","0",{"className":"rounded-lg border border-border bg-card/60 p-4 sm:p-5","children":[["$","h3",null,{"className":"font-semibold text-foreground text-sm mb-3","children":"Applicable Legal Bases"}],["$","ul",null,{"className":"space-y-2 text-xs sm:text-sm text-muted-foreground","children":[["$","li","0",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Contractual Necessity: Processing required to fulfill our Terms and Conditions and provide your requested NCLEX preparation subscription."}]]}],["$","li","1",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Legitimate Interests: Maintaining platform security, detecting fraud, improving study algorithms, and preventing abuse of prep materials."}]]}],["$","li","2",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Consent: Where you have provided unambiguous consent for specific voluntary communications or optional survey feedback."}]]}],["$","li","3",{"className":"flex items-start gap-2","children