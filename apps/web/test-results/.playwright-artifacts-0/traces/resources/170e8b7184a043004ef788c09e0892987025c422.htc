39:["$","section","section-10",{"id":"section-10","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"10. Data Sharing & Service Providers"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"PrepFord does not sell, rent, monetize, or trade candidate personal data. We never disclose your personal information to third-party advertisers or unauthorized data brokers."}],["$","p","1",{"children":"We share personal data strictly with vetted service providers bound by enforceable data processing agreements, including cloud hosting providers, database operators, customer support ticketing infrastructure, and transaction processors. These providers are authorized to process data solely to execute contracted services on our behalf."}]]}],"$undefined"]}]
3a:["$","section","section-11",{"id":"section-11","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"11. Payments & Transaction Information"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"Subscription transactions on PrepFord are processed entirely through certified, PCI-DSS Level 1 compliant payment gateways. PrepFord does not store, intercept, or handle raw payment card numbers, CVVs, or bank account credentials on its servers."}],["$","p","1",{"children":"We receive only transaction confirmation metadata (e.g., transaction identifier, subscription plan purchased, renewal date, and billing postal code) required for subscription provisioning and accounting records."}]]}],"$undefined"]}]
3b:["$","section","section-12",{"id":"section-12","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"12. Analytics & Communications"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"We utilize privacy-preserving diagnostic telemetry to identify server latency, broken routes, and accessibility friction points. We do not employ third-party tracking pixels that follow candidates across external web domains."}],["$","p","1",{"children":"Service Communications: We may send necessary transactional emails regarding account verification, password resets, subscription renewals, or critical security updates. You cannot opt out of essential transactional notices."}]]}],"$undefined"]}]
3c:["$","section","section-13",{"id":"section-13","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"13. Data Retention"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"We retain candidate personal data only as long as necessary to fulfill the educational purposes for which it was collected, maintain your study history, and satisfy statutory tax or legal requirements."}],["$","p","1",{"children":"When an account is closed or deleted, assessment telemetry is either permanently destroyed or fully anonymized so that it can no longer be associated with any individual candidate."}]]}],"$undefined"]}]
3d:["$","section","section-14",{"id":"section-14","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"14. Data Security"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"We apply rigorous technical and organizational safeguards to protect candidate data against unauthorized access, loss, or alteration:"}]]}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","div","0",{"className":"rounded-lg border border-border bg-card/60 p-4 sm:p-5","children":[["$","h3",null,{"className":"font-semibold text-foreground text-sm mb-3","children":"Technical Safeguards"}],["$","ul",null,{"className":"space-y-2 text-xs sm:text-sm text-muted-foreground","children":[["$","li","0",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Encryption in Transit: All web traffic is strictly enforced over HTTPS utilizing TLS 1.3 encryption."}]]}],["$","li","1",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Encryption at Rest: Sensitive database storage, password digests, and backups are encrypted using AES-256."}]]}],["$","li","2",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Access Governance: Strict principle-of-least-privilege access controls, multi-factor authentication (MFA) for administrative staff, and automated vulnerability scanning."}]]}]]}]]}]]}]]}]
3e:["$","section","section-15",{"id":"section-15","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"15. International Transfers"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"PrepFord operates infrastructure that may process data on servers located outside your country of residence. Where personal data is transferred across international boundaries, we ensure appropriate cross-border transfer safeguards, such as Standard Contractual Clauses (SCCs) or adequacy decisions recognized by relevant regulatory authorities."}]]}],"$undefined"]}]
3f:["$","section","section-16",{"id":"section-16","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"16. User Access, Correction, Deletion & Privacy Rights"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"Depending on your jurisdiction (including the European Economic Area, the United Kingdom, California, and Kenya under the Data Protection Act 2019), you may exercise specific statutory privacy rights:"}]]}],["$","div",null,{"className":"mt-4 space-y-4","children":[["$","div","0",{"className":"rounded-lg border border-border bg-card/60 p-4 sm:p-5","children":[["$","h3",null,{"className":"font-semibold text-foreground text-sm mb-3","children":"Your Rights Include"}],["$","ul",null,{"className":"space-y-2 text-xs sm:text-sm text-muted-foreground","children":[["$","li","0",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Right of Access: Request confirmation of whether we process your data and receive an exported copy of your personal records."}]]}],["$","li","1",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Right to Rectification: Correct inaccurate or incomplete profile information."}]]}],["$","li","2",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Right to Erasure ('Right to be Forgotten'): Request deletion of your account and associated personal data."}]]}],["$","li","3",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Right to Restrict Processing: Limit how we process your information under specific contested circumstances."}]]}],["$","li","4",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Right to Data Portability: Receive your assessment history in a structured, machine-readable format."}]]}],["$","li","5",{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-secondary font-bold shrink-0 mt-0.5","children":"â€¢"}],["$","span",null,{"children":"Right to Object: Object to processing based on legitimate interests."}]]}]]}]]}]]}]]}]
40:["$","section","section-17",{"id":"section-17","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"17. Children's & Minor Privacy"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"PrepFord is designed exclusively for adult nursing candidates and nursing students preparing for professional licensure. We do not knowingly market to or solicit personal data from individuals under the age of 18. If we learn that personal data from a child has been collected, we will take prompt steps to delete that information."}]]}],"$undefined"]}]
