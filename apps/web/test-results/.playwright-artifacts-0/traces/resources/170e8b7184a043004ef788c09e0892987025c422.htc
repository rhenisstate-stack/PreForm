33:["$","section","section-4",{"id":"section-4","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-serif font-bold text-foreground border-b border-border pb-2","children":"4. Account & Authentication Information"}],["$","div",null,{"className":"space-y-3 text-sm sm:text-base text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"To safeguard candidate accounts and prevent unauthorized access to prep materials, PrepFord implements secure authentication mechanisms:"}],["$","p","1",{"children":"Email/Password Authentication: When registering with email and password, passwords are never stored in plaintext. They are evaluated against high-entropy baseline security policies (zxcvbn score 3 or higher) and cryptographically hashed using salted, industry-standard key derivation functions before storage."}],["$","p","2",{"children":"Federated Google Authentication: When you sign in using Google OAuth 2.0, authentication occurs directly via Google's identity servers using the Authorization Code Flow with Proof Key for Code Exchange (PKCE, RFC 7636). We collect only your verified email address, full name, and unique Google account identifier provided by Google Identity Services. We never receive or store your Google account password."}]]}],"$undefined"]}]
